<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 실제 호출하는 API의 권한만 선언 (샘플 전체 권한 복사 금지) -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />   <!-- 앰비언트·실내등·독서등 조회(종료 시 복원할 원래 값) -->
    <!-- 조명 설정(종료 시 복원). SDK 어노테이션은 set에 CAR_LIGHTS만 표기하지만 런타임은 이 권한을 요구한다(에뮬레이터 2.1.0 확인).
         Playground에서 Vehicle Control은 "준비 중"이라 배포 앱 사용 가능 여부는 별도 확인 -->
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_LIGHTS" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" /> <!-- 기어(AAOS): P·N에서만 사용 -->
    <uses-permission android:name="android.permission.INTERNET" />       <!-- 폰 연결(영상·조명 값) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" /> <!-- USB 테더링 네트워크에서 폰(게이트웨이) 찾기 -->
    <!-- USB 액세서리 경로(2차): 차가 호스트로 폰을 연다. 없는 차에서도 설치되게 required=false -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application
        android:label="Selene"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
